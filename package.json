{
  "name": "account-registration-automation",
  "version": "1.0.0",
  "description": "Серверное Node.js-приложение для автоматизации регистрации аккаунтов с использованием Playwright, AdsPower, Capsolver и firstmail.ltd",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db": "node scripts/db.js",
    "stats": "node scripts/db.js stats"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.5",
    "imapflow": "1.3.3",
    "mailparser": "3.9.8",
    "playwright": "^1.44.0",
    "socks": "2.8.3",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
