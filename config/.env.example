# ============================================================
# Шаблон конфигурации системы автоматизации регистрации аккаунтов
# Скопируйте этот файл в корень проекта как .env и заполните значения
# ============================================================

# URL страницы регистрации на сайте
TARGET_URL=

# Максимальное количество попыток для одного email
MAX_RETRIES=3

# Таймаут ожидания письма с кодом (мс)
EMAIL_TIMEOUT_MS=90000

# Таймаут ожидания элементов Playwright (мс)
PLAYWRIGHT_TIMEOUT_MS=30000

# API ключ Capsolver для решения капч
CAPSOLVER_API_KEY=

# URL AdsPower Local API
ADSPOWER_API_URL=http://local.adspower.net:50325

# ID группы профилей в AdsPower
ADSPOWER_GROUP_ID=

# Протокол прокси для браузера: http, https, socks5
PROXY_PROTOCOL=socks5

# Количество параллельных воркеров
CONCURRENCY=1

# Тип БД: sqlite
DB_TYPE=sqlite

# Путь к файлу SQLite БД
DB_PATH=./data/accounts.db

# Уровень логирования: error, warn, info, debug
LOG_LEVEL=info

# Регулярное выражение для извлечения кода из письма
CODE_REGEX=\d{4,8}

# Фильтр по домену отправителя письма с кодом (например: noreply@example.com)
# Оставьте пустым чтобы не фильтровать
EMAIL_SENDER_PATTERN=
