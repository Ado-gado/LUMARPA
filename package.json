{
  "name": "luma-registration-bot",
  "version": "1.0.1",
  "description": "Автоматизация регистрации аккаунтов: Playwright + AdsPower + Capsolver + GMX IMAP + Electron UI",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db": "node scripts/db.js",
    "stats": "node scripts/db.js stats",
    "api": "node src/api.js",
    "ui:install": "npm install --prefix src/ui",
    "ui:dev": "npm run dev --prefix src/ui",
    "ui:build": "npm run build --prefix src/ui",
    "dev:all": "concurrently -k -n API,UI -c blue,green \"npm run api\" \"npm run ui:dev\"",
    "build:electron": "npm run ui:build",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n API,ELE -c blue,magenta \"npm run api\" \"wait-on http://127.0.0.1:3001 && electron .\"",
    "dist": "npm run build:electron && electron-builder --win nsis",
    "dist:dir": "npm run build:electron && electron-builder --win nsis --dir"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-updater": "6.8.3",
    "express": "^4.21.2",
    "imapflow": "1.3.3",
    "mailparser": "3.9.8",
    "playwright": "^1.44.0",
    "socks": "2.8.3",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "build": {
    "appId": "com.lumabot.registration",
    "productName": "Luma Registration Bot",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "Ado-gado",
      "repo": "LUMARPA"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "scripts/**/*",
      "package.json",
      "!src/ui/node_modules",
      "!src/ui/src",
      "!src/ui/index.html",
      "!src/ui/vite.config.js",
      "!src/ui/tailwind.config.js",
      "!src/ui/postcss.config.js",
      "!src/ui/package.json",
      "!src/ui/yarn.lock",
      "src/ui/dist/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "LumaBot-Setup-${version}.exe",
      "signingHashAlgorithms": null,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luma Registration Bot",
      "deleteAppDataOnUninstall": false
    }
  }
}
